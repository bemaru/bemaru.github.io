---
import type { Project } from '../utils/content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TagList from '../components/TagList.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  canonicalPath={`/projects/${project.id}/`}
  noindex={project.data.draft}
  contentClass="article-shell"
>
  <article class="project-detail shell narrow">
    <Breadcrumbs
      items={[
        { label: '홈', href: '/' },
        { label: '프로젝트', href: '/projects/' },
        { label: project.data.title },
      ]}
    />

    <header class="article-header project-header">
      <div class="article-kicker-row">
        <span class="category-label">Project · {project.data.period}</span>
        {project.data.draft && <span class="status-badge">Draft</span>}
      </div>
      <h1>{project.data.title}</h1>
      <p class="article-description">{project.data.description}</p>
      {project.data.tags.length > 0 && <TagList tags={project.data.tags} />}
      {project.data.links && (
        <div class="project-links">
          {project.data.links.github && (
            <a href={project.data.links.github} target="_blank" rel="noreferrer">GitHub</a>
          )}
          {project.data.links.demo && (
            <a href={project.data.links.demo} target="_blank" rel="noreferrer">Demo</a>
          )}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
