---
import type { Project } from '../utils/content';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  canonicalPath={`/projects/${project.id}/`}
  noindex={project.data.draft}
  contentClass="article-shell"
>
  <article class="article-detail">
    <header class="article-header">
      <div class="eyebrow-row">
        <span class="eyebrow">Project</span>
        {project.data.draft && <span class="status-badge">Draft</span>}
      </div>
      <h1>{project.data.title}</h1>
      <p class="article-description">{project.data.description}</p>
      <p class="project-period">{project.data.period}</p>
      {project.data.tags.length > 0 && <TagList tags={project.data.tags} linked={false} />}
      {project.data.links && (
        <div class="project-links">
          {project.data.links.github && (
            <a class="button secondary" href={project.data.links.github} target="_blank" rel="noreferrer">GitHub</a>
          )}
          {project.data.links.demo && (
            <a class="button primary" href={project.data.links.demo} target="_blank" rel="noreferrer">Demo</a>
          )}
        </div>
      )}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article-footer">
      <a class="back-link" href="/projects/">← Projects 목록</a>
    </footer>
  </article>
</BaseLayout>
