---
import type { Post } from '../utils/content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const canonicalPath = `/writing/${post.id}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  mainEntityOfPage: new URL(canonicalPath, Astro.site ?? Astro.url.origin).href,
  author: {
    '@type': 'Person',
    name: 'bemaru',
    url: new URL('/about/', Astro.site ?? Astro.url.origin).href,
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={canonicalPath}
  canonicalUrl={post.data.canonicalUrl}
  type="article"
  noindex={post.data.draft}
  contentClass="article-shell"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.publishedAt.toISOString()} />
    {post.data.updatedAt && (
      <meta property="article:modified_time" content={post.data.updatedAt.toISOString()} />
    )}
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <article class="article-detail">
    <header class="article-header">
      <div class="eyebrow-row">
        <span class="eyebrow">Writing</span>
        {post.data.draft && <span class="status-badge">Draft</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-dates">
        <span>작성 <FormattedDate date={post.data.publishedAt} /></span>
        {post.data.updatedAt && (
          <span>수정 <FormattedDate date={post.data.updatedAt} /></span>
        )}
      </div>
      {post.data.tags.length > 0 && <TagList tags={post.data.tags} />}
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="article-footer">
      <a class="back-link" href="/writing/">← Writing 목록</a>
    </footer>
  </article>
</BaseLayout>
