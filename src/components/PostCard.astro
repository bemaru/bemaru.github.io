---
import type { Post } from '../utils/content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
---

<article class="post-card">
  <div class="post-card-meta">
    <FormattedDate date={post.data.publishedAt} />
  </div>

  {headingLevel === 2 ? (
    <h2 class="post-card-title">
      <a href={`/writing/${post.id}/`}>{post.data.title}</a>
    </h2>
  ) : (
    <h3 class="post-card-title">
      <a href={`/writing/${post.id}/`}>{post.data.title}</a>
    </h3>
  )}
  <p class="post-card-description">{post.data.description}</p>
</article>
