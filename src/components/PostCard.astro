---
import type { Post } from '../utils/content';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="content-card">
  <div class="card-meta">
    <FormattedDate date={post.data.publishedAt} />
    {post.data.draft && <span class="status-badge">Draft</span>}
  </div>
  <h3><a href={`/writing/${post.id}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  {post.data.tags.length > 0 && <TagList tags={post.data.tags} />}
</article>
