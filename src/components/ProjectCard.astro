---
import type { Project } from '../utils/content';
import TagList from './TagList.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-card-meta">
    <span>{project.data.period}</span>
    {project.data.featured && <span class="status-badge">Featured</span>}
    {project.data.draft && <span class="status-badge">Draft</span>}
  </div>
  <h2 class="project-card-title">
    <a href={`/projects/${project.id}/`}>{project.data.title}</a>
  </h2>
  <p>{project.data.description}</p>
  {project.data.tags.length > 0 && <TagList tags={project.data.tags.slice(0, 5)} />}
</article>
