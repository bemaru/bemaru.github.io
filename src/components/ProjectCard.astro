---
import type { Project } from '../utils/content';
import TagList from './TagList.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="content-card project-card">
  <div class="card-meta">
    <span>{project.data.period}</span>
    {project.data.draft && <span class="status-badge">Draft</span>}
  </div>
  <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
  <p>{project.data.description}</p>
  {project.data.tags.length > 0 && <TagList tags={project.data.tags} linked={false} />}
</article>
