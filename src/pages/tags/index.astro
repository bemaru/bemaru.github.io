---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getSitePosts } from '../../utils/content';
import { collectTags } from '../../utils/tags';

const groups = collectTags(await getSitePosts());
---

<BaseLayout
  title="태그"
  description="기술과 도구 단위로 글을 탐색할 수 있는 태그 목록입니다."
  noindex={groups.length === 0}
>
  <section class="page-header shell">
    <p class="page-eyebrow">Tags</p>
    <h1>태그</h1>
    <p>카테고리보다 구체적인 기술과 도구를 기준으로 탐색합니다.</p>
  </section>

  <section class="section shell">
    {groups.length > 0 ? (
      <div class="tag-cloud">
        {groups.map((group) => (
          <a href={`/tags/${group.slug}/`}>
            <span>#{group.name}</span>
            <small>{group.posts.length}</small>
          </a>
        ))}
      </div>
    ) : (
      <EmptyState title="태그가 없습니다." description="글이 발행되면 태그가 자동으로 생성됩니다." />
    )}
  </section>
</BaseLayout>
