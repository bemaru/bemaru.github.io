---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSitePosts, type Post } from '../../utils/content';
import { collectTags, type TagGroup } from '../../utils/tags';

export async function getStaticPaths() {
  const groups = collectTags(await getSitePosts());
  return groups.map((group) => ({
    params: { tag: group.slug },
    props: { group },
  }));
}

interface Props {
  group: TagGroup;
}

const { group } = Astro.props;
const posts: Post[] = group.posts;
---

<BaseLayout
  title={`#${group.name}`}
  description={`${group.name} 태그가 붙은 기술 글입니다.`}
>
  <section class="page-header shell">
    <p class="page-eyebrow">Tag</p>
    <h1>#{group.name}</h1>
    <p>{posts.length}개의 글</p>
  </section>

  <section class="section shell">
    <div class="post-list">
      {posts.map((post) => <PostCard post={post} headingLevel={2} />)}
    </div>
  </section>
</BaseLayout>
