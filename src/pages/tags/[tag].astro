---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSitePosts, type Post } from '../../utils/content';
import { collectTags } from '../../utils/tags';

export async function getStaticPaths() {
  const tags = collectTags(await getSitePosts());
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: tag.posts },
  }));
}

interface Props {
  name: string;
  posts: Post[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`${name} 태그가 붙은 기술 글입니다.`}>
  <section class="page-header shell narrow">
    <p class="eyebrow">Tag</p>
    <h1>#{name}</h1>
    <p>{posts.length}개의 글</p>
  </section>
  <section class="section shell narrow">
    <div class="content-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
