---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getSiteProjects } from '../../utils/content';

const projects = await getSiteProjects();
---

<BaseLayout title="Projects" description="대표 작업을 문제와 의사결정 중심의 케이스 스터디로 정리합니다.">
  <section class="page-header shell narrow">
    <p class="eyebrow">Projects</p>
    <h1>프로젝트</h1>
    <p>무엇을 만들었는지보다 어떤 문제를 어떤 근거로 해결했는지에 집중합니다.</p>
  </section>
  <section class="section shell">
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <EmptyState title="프로젝트를 정리하고 있습니다." description="공개 가능한 사례부터 추가합니다." />
    )}
  </section>
</BaseLayout>
