---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getSiteProjects } from '../../utils/content';

const projects = await getSiteProjects();
---

<BaseLayout
  title="프로젝트"
  description="문제, 역할, 기술적 의사결정과 검증 결과를 정리한 프로젝트 사례입니다."
>
  <section class="page-header shell">
    <p class="page-eyebrow">Projects</p>
    <h1>프로젝트</h1>
    <p>기능 목록보다 문제와 판단, 검증 결과를 중심으로 정리합니다.</p>
  </section>

  <section class="section shell">
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    ) : (
      <EmptyState
        title="아직 공개된 프로젝트 사례가 없습니다."
        description="공개 가능한 범위로 일반화하고 검증한 사례만 추가합니다."
      />
    )}
  </section>
</BaseLayout>
