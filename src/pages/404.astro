---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" noindex>
  <section class="error-page shell narrow">
    <p class="page-eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다.</h1>
    <p>주소가 변경되었거나 삭제된 페이지입니다. 글을 검색하거나 홈으로 이동하세요.</p>
    <SearchForm compact />
    <a class="button-link" href="/">홈으로 이동</a>
  </section>
</BaseLayout>
