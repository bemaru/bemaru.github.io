---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL } from '../consts';
---

<BaseLayout title="소개" description="개발자 bemaru의 소개입니다.">
  <section class="page-header shell narrow">
    <h1>소개</h1>
    <p>
      개발자 bemaru입니다.<br />
      보안 제품의 백엔드와 AI 에이전트를 개발하고 있습니다.
    </p>
    <p><a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a></p>
  </section>
</BaseLayout>
