---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getSitePosts, getSiteProjects } from '../utils/content';

const posts = await getSitePosts();
const projects = await getSiteProjects();
const latestPosts = posts.slice(0, 4);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">Backend · Security · AI Agent Engineering</p>
    <h1>실무에서 배운 것을,<br />다시 쓸 수 있는 지식으로.</h1>
    <p class="hero-copy">
      문제를 해결한 과정, 기술적 의사결정, 실패와 개선을 기록합니다.
      짧은 팁보다 다음 프로젝트에서도 재사용할 수 있는 맥락을 남기는 것이 목표입니다.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="/writing/">글 보기</a>
      <a class="button secondary" href="/about/">소개</a>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Focus</p>
        <h2>다루는 주제</h2>
      </div>
    </div>
    <div class="focus-grid">
      <article>
        <span>01</span>
        <h3>AI Agent Engineering</h3>
        <p>도구 호출, 오케스트레이션, 평가와 운영 경계를 실제 시스템 관점에서 정리합니다.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Backend & Search</h3>
        <p>Python, Go, OpenSearch를 중심으로 서비스 설계와 장애 해결 과정을 기록합니다.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Security Engineering</h3>
        <p>EDR와 탐지 시스템을 개발하며 배운 보안 도메인 지식과 엔지니어링 판단을 다룹니다.</p>
      </article>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Latest</p>
        <h2>최근 글</h2>
      </div>
      <a class="text-link" href="/writing/">전체 글 →</a>
    </div>
    {latestPosts.length > 0 ? (
      <div class="content-list">
        {latestPosts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <EmptyState
        title="공개 글을 준비하고 있습니다."
        description="검토가 끝난 글부터 순차적으로 공개합니다."
      />
    )}
  </section>

  {featuredProjects.length > 0 && (
    <section class="section shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected</p>
          <h2>프로젝트</h2>
        </div>
        <a class="text-link" href="/projects/">전체 프로젝트 →</a>
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}
</BaseLayout>
