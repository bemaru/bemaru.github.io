---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getSitePosts } from '../utils/content';

const posts = await getSitePosts();
const latestPosts = posts.slice(0, 6);
---

<BaseLayout>
  <section class="section shell home-posts" aria-labelledby="recent-posts">
    <div class="section-heading home-heading">
      <h1 id="recent-posts">글</h1>
    </div>

    {latestPosts.length > 0 ? (
      <div class="post-list">
        {latestPosts.map((post) => <PostCard post={post} headingLevel={2} />)}
      </div>
    ) : (
      <div class="empty-state home-empty-state">
        <p class="empty-state-title">아직 공개된 글이 없습니다.</p>
      </div>
    )}
  </section>
</BaseLayout>
