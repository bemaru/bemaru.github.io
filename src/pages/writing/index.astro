---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import PostCard from '../../components/PostCard.astro';
import { getSitePosts } from '../../utils/content';

const posts = await getSitePosts();
---

<BaseLayout title="Writing" description="문제 해결 과정과 기술적 의사결정을 기록한 글입니다.">
  <section class="page-header shell narrow">
    <p class="eyebrow">Writing</p>
    <h1>기술 글</h1>
    <p>결과만 남기기보다 문제, 판단, 검증과 운영의 맥락을 함께 기록합니다.</p>
  </section>
  <section class="section shell narrow">
    {posts.length > 0 ? (
      <div class="content-list">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <EmptyState title="아직 공개된 글이 없습니다." description="첫 글을 준비하고 있습니다." />
    )}
  </section>
</BaseLayout>
