---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmptyState from '../../components/EmptyState.astro';
import PostCard from '../../components/PostCard.astro';
import SearchForm from '../../components/SearchForm.astro';
import { getSitePosts } from '../../utils/content';

const posts = await getSitePosts();
---

<BaseLayout
  title="글"
  description="백엔드, 보안, AI Agent Engineering의 문제 해결 과정과 기술적 판단을 기록한 글입니다."
>
  <section class="page-header shell">
    <p class="page-eyebrow">Writing</p>
    <h1>글</h1>
    <p>실제 문제와 검증 과정을 중심으로 정리한 기술 기록입니다.</p>
    <div class="page-tools">
      <SearchForm compact />
      <div class="page-tool-links">
        <a href="/archive/">연도별</a>
        <a href="/tags/">태그</a>
        <a href="/categories/">카테고리</a>
      </div>
    </div>
  </section>

  <section class="section shell">
    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => <PostCard post={post} headingLevel={2} />)}
      </div>
    ) : (
      <EmptyState
        title="아직 공개된 글이 없습니다."
        description="검증과 공개 범위 확인을 마친 글부터 순차적으로 발행합니다."
      />
    )}
  </section>
</BaseLayout>
